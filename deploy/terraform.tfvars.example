aws_region   = "us-east-1"
project_name = "fastapi-ecs"
environment  = "dev"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

container_port    = 8000
health_check_path = "/api/health"

# ECS Task & Service settings
ecs_task_cpu    = "256"
ecs_task_memory = "512"
desired_count   = 2

# Optional custom image (defaults to ECR repository URL:latest if left empty)
app_image = ""

